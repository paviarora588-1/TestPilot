# Local AI is the default — no API key or paid service required.
# Run scripts/setup-local-ai.ps1 once, then start the backend as usual.
AI_PROVIDER=local
MODEL_NAME=Qwen2.5-1.5B-Instruct-Q4_K_M
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_SERVER_EXECUTABLE=.tools/llama.cpp/llama-server.exe
LOCAL_AI_MODEL_PATH=.tools/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_AI_CONTEXT_SIZE=4096
LOCAL_AI_THREADS=8
# Optional: screenshot -> test case feature. Only used after running
# scripts/setup-local-ai.ps1 -WithVision; always local, ignores AI_PROVIDER.
LOCAL_VISION_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_VISION_SERVER_EXECUTABLE=.tools/llama.cpp/llama-server.exe
LOCAL_VISION_MODEL_PATH=.tools/models/qwen2-vl-2b-instruct-q4_k_m.gguf
LOCAL_VISION_MMPROJ_PATH=.tools/models/qwen2-vl-2b-instruct-mmproj-f16.gguf
LOCAL_VISION_CONTEXT_SIZE=4096
LOCAL_VISION_THREADS=8
# Only needed if you set AI_PROVIDER=openai instead of the local default.
OPENAI_API_KEY=
DATABASE_URL=sqlite:///./testpilot.db
ENABLE_LOCAL_RUNNER=true
UPLOAD_DIR=app/uploads
GENERATED_SCRIPT_DIR=app/generated_scripts
FRONTEND_ORIGIN=http://localhost:5173
VECTOR_DB_TYPE=mock
JIRA_BASE_URL=
ZEPHYR_TOKEN=
