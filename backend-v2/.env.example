# Configure locally; never commit real credentials.
DATABASE_URL=
JWT_ACCESS_SECRET=
INTEGRATION_ENCRYPTION_KEY=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Recommended project configuration. A missing key prevents OpenAI startup.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional existing providers; set only when using them.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=
LLAMACPP_EMBEDDING_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=
# This flag belongs to legacy code; v2 currently does not enforce it.
ENABLE_LOCAL_RUNNER=false
